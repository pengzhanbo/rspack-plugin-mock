{
  "name": "rspack-plugin-mock",
  "version": "2.2.0",
  "description": "inject api mock server to development server",
  "keywords": [
    "mock",
    "mock server",
    "rsbuild",
    "rsbuild-plugin",
    "rspack",
    "rspack-plugin"
  ],
  "homepage": "https://github.com/pengzhanbo/rspack-plugin-mock",
  "license": "MIT",
  "author": "pengzhanbo <q942450674@outlook.com> (https://github.com/pengzhanbo)",
  "repository": {
    "type": "git",
    "url": "https://github.com/pengzhanbo/rspack-plugin-mock"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "imports": {
    "#json5-loader": "./dist/json5-loader.mjs"
  },
  "exports": {
    ".": "./dist/index.js",
    "./helper": "./dist/helper.js",
    "./rsbuild": "./dist/rsbuild.js",
    "./server": "./dist/server.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsdown src --watch",
    "build": "tsdown",
    "lint": "oxlint . --type-check --type-aware",
    "format": "oxfmt .",
    "prepare": "simple-git-hooks",
    "release:publish": "pnpm -r publish",
    "release:changelog": "conventional-changelog -p angular",
    "release": "bumpp package.json --execute=\"pnpm release:changelog\" --commit --all --push --tag"
  },
  "dependencies": {
    "@pengzhanbo/utils": "^3.10.0",
    "ansis": "^4.3.1",
    "chokidar": "^5.0.0",
    "co-body": "^6.2.0",
    "cookies": "^0.9.1",
    "cors": "^2.8.6",
    "formidable": "^3.5.4",
    "http-status": "^2.1.0",
    "json5": "^2.2.3",
    "local-pkg": "^1.2.1",
    "memfs": "^4.68.0",
    "mime-types": "^3.0.2",
    "path-to-regexp": "^8.4.2",
    "picomatch": "^4.0.5",
    "tinyglobby": "^0.2.17",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@pengzhanbo/oxc-config": "^2.8.5",
    "@rsbuild/core": "^2.1.10",
    "@rspack/core": "^2.1.8",
    "@types/co-body": "^6.1.3",
    "@types/cookies": "^0.9.2",
    "@types/cors": "^2.8.19",
    "@types/formidable": "^3.5.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.2.0",
    "@types/picomatch": "^4.0.3",
    "@types/ws": "^8.18.1",
    "bumpp": "^12.2.0",
    "conventional-changelog": "^7.2.0",
    "conventional-changelog-angular": "^8.3.1",
    "js-tokens": "^10.0.0",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "zstd-codec": "^0.1.5"
  },
  "peerDependencies": {
    "@rsbuild/core": ">=2.0.0",
    "@rspack/core": ">=2.0.0",
    "zstd-codec": ">=0.1.5"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    },
    "@rspack/core": {
      "optional": true
    },
    "zstd-codec": {
      "optional": true
    }
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged --allow-empty"
  },
  "nano-staged": {
    "*.{js,ts,mjs,cjs}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.21.0"
}
